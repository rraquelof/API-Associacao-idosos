          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "cpf": {
            "type": "string"
          },
          "senha": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "coordenador",
              "familiar"
            ]
          },
          "sexo": {
            "type": "string",
            "enum": [
              "masculino",
              "feminino",
              "outro"
            ]
          },
          "endereco": {
            "type": "string"
          },
          "telefone": {
            "type": "string"
          }
        },
        "required": [
          "nome",
          "email",
          "cpf",
          "senha",
          "tipo",
          "sexo",
          "endereco",
          "telefone"
        ]
      },
      "Idoso": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "cpf": {
            "type": "string"
          },
          "rg": {
            "type": "string"
          },
          "sus": {
            "type": "string"
          },
          "data_nascimento": {
            "type": "string",
            "format": "date"
          },
          "sexo": {
            "type": "string"
          },
          "nacionalidade": {
            "type": "string"
          },
          "naturalidade": {
            "type": "string"
          }
        },
        "required": [
          "nome",
          "cpf",
          "rg",
          "sus",
          "data_nascimento",
          "sexo",
          "nacionalidade",
          "naturalidade"
        ]
      },

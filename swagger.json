          "descricao",
          "data",
          "local"
        ]
      },
      "Saude": {
        "type": "object",
        "properties": {
          "usuarioId": { "type": "string" },
          "idosoId": { "type": "string" },
          "dataConsulta": { "type": "string", "format": "date-time" },
          "altura": { "type": "number" },
          "peso": { "type": "number" },
          "pressao": { "type": "string" },
          "alergias": { "type": "array", "items": { "type": "string" } },

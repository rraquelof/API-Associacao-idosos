{
  "openapi": "3.0.0",
  "info": {
    "title": "API de Associação de Idosos",
    "version": "1.0.0",
    "description": "API para gerenciar associações de idosos, incluindo usuários, idosos, eventos e acompanhamentos."
  },
  "servers": [
    {
      "url": "http://localhost:3333/api",
      "description": "Servidor local"
    }
  ],
  "paths": {
    "/cadastrarUsuario": {
      "post": {
        "summary": "Cadastrar usuário",
        "tags": ["Usuários"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/User" }
            }
          }
        },
        "responses": {
          "201": { "description": "Usuário criado com sucesso" },
          "400": { "description": "Erro de validação ou dado já cadastrado" },
          "500": { "description": "Erro interno do servidor" }
        }
      }
    },
    "/login": {
      "post": {
        "summary": "Login do usuário",
        "tags": ["Autenticação"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "senha": { "type": "string" }
                },
                "required": ["email", "senha"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login realizado com sucesso" },
          "401": { "description": "Erro de autenticação" },
          "404": { "description": "Usuário não encontrado" }
        }
      }
    },
    "/cadastrarIdoso": {
      "post": {
        "summary": "Cadastrar idoso",
        "tags": ["Idosos"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/Idoso" } }
          }
        },
        "responses": {
          "201": { "description": "Idoso cadastrado com sucesso" },
          "400": { "description": "Erro de validação ou idoso já cadastrado" },
          "403": { "description": "Acesso negado: apenas coordenadores podem realizar esta ação." },
          "500": { "description": "Erro interno do servidor" }
        }
      }
    },
    "/idosos": {
      "get": {
        "summary": "Listar todos os idosos",
        "tags": ["Idosos"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista de idosos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Idoso" }
                }
              }
            }
          },
          "403": { "description": "Acesso negado: apenas coordenadores podem realizar esta ação." },
          "404": { "description": "Nenhum idoso encontrado" },
          "500": { "description": "Erro interno do servidor" }
        }
      }
    },
    "/idoso/{id}": {
      "get": {
        "summary": "Buscar idoso por ID",
        "tags": ["Idosos"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Idoso encontrado",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Idoso" } }
            }
          },
          "400": { "description": "Erro de validação" },
          "403": { "description": "Acesso negado: apenas coordenadores podem realizar esta ação." },
          "404": { "description": "Idoso não encontrado" },
          "500": { "description": "Erro interno do servidor" }
        }
      },
      "put": {
        "summary": "Atualizar idoso",
        "tags": ["Idosos"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/Idoso" } }
          }
        },
        "responses": {
          "200": { "description": "Idoso atualizado com sucesso" },
          "400": { "description": "Erro de validação" },
          "403": { "description": "Acesso negado: apenas coordenadores podem realizar esta ação." },
          "404": { "description": "Idoso não encontrado" },
          "500": { "description": "Erro interno do servidor" }
        }
      },
      "delete": {
        "summary": "Deletar idoso",
        "tags": ["Idosos"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Idoso deletado com sucesso" },
          "400": { "description": "Erro de validação" },
          "403": { "description": "Acesso negado: apenas coordenadores podem realizar esta ação." },
          "404": { "description": "Idoso não encontrado" },
          "500": { "description": "Erro interno do servidor" }
        }
      }
    },
    "/cadastrarAcompanhamento": {
      "post": {
        "summary": "Criar acompanhamento",
        "tags": ["Acompanhamentos"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "usuarioId": { "type": "string" },
                  "idosoId": { "type": "string" }
                },
                "required": ["usuarioId", "idosoId"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Acompanhamento criado" },
          "403": { "description": "Acesso negado: apenas coordenadores podem realizar esta ação" },
          "404": { "description": "Usuário ou idoso não encontrado" },
          "500": { "description": "Erro interno do servidor" }
        }
      }
    },
    "/acompanhamentos": {
      "get": {
        "summary": "Listar todos os acompanhamentos",
        "tags": ["Acompanhamentos"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista de acompanhamentos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Acompanhamento" }
                }
              }
            }
          },
          "403": { "description": "Acesso negado: apenas coordenadores podem realizar esta ação" },
          "500": { "description": "Erro interno do servidor" }
        }
      }
    },
    "/acompanhamento/familiar": {
      "get": {
        "summary": "Listar acompanhamentos do familiar logado",
        "tags": ["Acompanhamentos"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista de acompanhamentos do familiar",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Acompanhamento" }
                }
              }
            }
          },
          "403": { "description": "Acesso negado: apenas familiares podem realizar esta ação" },
          "500": { "description": "Erro interno do servidor" }
        }
      }
    },
    "/acompanhamento/{id}": {
      "delete": {
        "summary": "Deletar acompanhamento",
        "tags": ["Acompanhamentos"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Acompanhamento deletado" },
          "403": { "description": "Acesso negado: apenas coordenadores podem realizar esta ação" },
          "500": { "description": "Erro interno do servidor" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "nome": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "cpf": { "type": "string" },
          "senha": { "type": "string" },
          "tipo": {
            "type": "string",
            "enum": ["coordenador", "voluntario", "familiar", "enfermeiro"]
          },
          "sexo": { "type": "string" },
          "endereco": { "type": "string" },
          "telefone": { "type": "string" }
        },
        "required": ["nome", "email", "cpf", "senha", "tipo"]
      },
      "Idoso": {
        "type": "object",
        "properties": {
          "nome": { "type": "string" },
          "cpf": { "type": "string" },
          "rg": { "type": "string" },
          "sus": { "type": "string" },
          "data_nascimento": { "type": "string", "format": "date" },
          "sexo": { "type": "string" },
          "nacionalidade": { "type": "string" },
          "naturalidade": { "type": "string" }
        },
        "required": ["nome", "cpf", "rg", "sus", "data_nascimento", "sexo", "nacionalidade", "naturalidade"]
      },
      "Acompanhamento": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "usuario": { "$ref": "#/components/schemas/User" },
          "idoso": { "$ref": "#/components/schemas/Idoso" }
        },
        "required": ["id", "usuario", "idoso"]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
